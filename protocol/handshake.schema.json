{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://engineering-platform.local/protocol/handshake.schema.json",
  "title": "Engineering Platform Handshake Frames (protocol 1.0)",
  "description": "握手三类帧：hello（客户端→宿主）、hello_ack（宿主→客户端）、bye（任一侧）。握手必须在一个 TCP-like 连接内完成，且必须发在第一个业务帧之前。",
  "$defs": {
    "Hello": {
      "$id": "#/$defs/Hello",
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "protocolVersion", "clientInfo", "clientNonce"],
      "properties": {
        "kind": { "const": "hello" },
        "protocolVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+$" },
        "clientInfo": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "version"],
          "properties": {
            "name": { "type": "string", "minLength": 1, "maxLength": 80, "examples": ["engineering-mcp"] },
            "version": { "type": "string", "minLength": 1, "maxLength": 40, "examples": ["0.1.0"] },
            "pid": { "type": ["integer", "null"], "minimum": 1 }
          }
        },
        "clientNonce": {
          "type": "string",
          "pattern": "^[0-9a-f]{16,64}$",
          "description": "16–64 hex 随机串，宿主在 hello_ack 中回显，用于抵消重放与错连。"
        },
        "requestedFeatures": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["preview", "cancel", "heartbeat", "taskReconcile", "layers", "query", "describe", "anomalies"]
          },
          "maxItems": 20,
          "description": "客户端想用的能力；宿主不支持的项进 missingFeatures，不影响握手成功。"
        }
      },
      "examples": [
        {
          "kind": "hello",
          "protocolVersion": "1.0",
          "clientInfo": { "name": "engineering-mcp", "version": "0.1.0", "pid": 18244 },
          "clientNonce": "9c1f8b2a4e7d0f61",
          "requestedFeatures": ["preview", "cancel", "heartbeat", "taskReconcile"]
        }
      ]
    },
    "HelloAck": {
      "$id": "#/$defs/HelloAck",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind", "protocolVersion", "hostVersion", "hostProduct", "hostRelease",
        "hostInstanceId", "sessionToken",
        "serverTimeUtc", "writeEnabled", "capabilities", "gaps"
      ],
      "properties": {
        "kind": { "const": "hello_ack" },
        "protocolVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+$" },
        "hostVersion": {
          "type": "string",
          "maxLength": 40,
          "description": "插件版本号（如 0.1.0+net48）。与实例发现文件的 hostVersion 同语义，不得复用为 CAD 版本。"
        },
        "hostProduct": {
          "type": "string",
          "enum": ["AutoCAD", "Civil3D"],
          "description": "宿主产品。由反射探测 AeccDbMgd 得到（Civil3D），探测不到即 AutoCAD，不做假设。"
        },
        "hostRelease": {
          "type": "string",
          "pattern": "^R[0-9]+\\.[0-9]+$",
          "examples": ["R24.3", "R23.0", "R24.1"],
          "description": "宿主发行版本：ACADVER（24.3s）→ R24.3；取不到为 unknown。"
        },
        "hostInstanceId": { "type": "string", "pattern": "^(acad|civil|revit|p3d|mock)-[0-9a-f]{8}$" },
        "sessionToken": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "serverTimeUtc": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$" },
        "clientNonceEcho": { "type": ["string", "null"] },
        "writeEnabled": { "type": "boolean", "description": "写通道是否开启（M1 起可为 true）" },
        "capabilities": {
          "type": "object",
          "additionalProperties": true,
          "required": ["domains", "writeEnabled", "civilApi", "preview", "messageLimitBytes", "heartbeat", "cancellation", "toolCatalogHash"]
        },
        "gaps": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["capability", "status", "reason"],
            "properties": {
              "capability": { "type": "string", "maxLength": 120 },
              "status": { "enum": ["absent", "degraded", "unverified"] },
              "reason": { "type": "string", "maxLength": 500 },
              "nextAction": { "type": ["string", "null"], "maxLength": 500 }
            }
          }
        },
        "missingFeatures": { "type": "array", "items": { "type": "string" }, "maxItems": 20 },
        "warnings": {
          "type": "array",
          "description": "握手阶段告警。客户端次版本高于宿主时必须带 W1002 client_ahead；空数组也要照发，客户端无需判断字段存在性。",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["code", "message"],
            "properties": {
              "code": { "type": "string", "pattern": "^W[0-9]{4}$" },
              "message": { "type": "string", "maxLength": 500 },
              "detail": { "type": ["string", "null"], "maxLength": 2000 }
            }
          },
          "maxItems": 10
        }
      },
      "examples": [
        {
          "kind": "hello_ack",
          "protocolVersion": "1.0",
          "hostVersion": "0.1.0+net48",
          "hostProduct": "Civil3D",
          "hostRelease": "R24.3",
          "hostInstanceId": "civil-3f7c1a92",
          "sessionToken": "9f2c1d4a7b0e3856a1c2d3e4f5061728394a5b6c7d8e9f0011223344556677a",
          "serverTimeUtc": "2026-11-21T14:03:11.902Z",
          "clientNonceEcho": "9c1f8b2a4e7d0f61",
          "writeEnabled": false,
          "capabilities": {
            "domains": ["sys", "read", "task"],
            "writeEnabled": false,
            "civilApi": {
              "available": true,
              "product": "Civil3D",
              "release": "R24.3",
              "probe": "ResolveType('Autodesk.Civil.ApplicationServices.CivilApplication, AeccDbMgd') && CivilApplication.ActiveDocument != null",
              "reason": "已探测到 Civil 3D 托管 API（AeccDbMgd 可解析），原生对象按 confidence=1.0 读取",
              "writeSupported": false
            },
            "preview": { "formats": ["png"], "maxWidth": 2400, "maxHeight": 1600, "renderMode": "schematic" },
            "messageLimitBytes": 1048576,
            "heartbeat": { "intervalMs": 5000, "missLimit": 3 },
            "cancellation": true,
            "toolCatalogHash": "sha256:1f4b0c8d9e2a7b3c"
          },
          "gaps": [
            {
              "capability": "write.*",
              "status": "absent",
              "reason": "M0 写入通道硬关闭（writeEnabled=false）",
              "nextAction": "等待 M1 审批写入流程"
            }
          ],
          "missingFeatures": []
        },
        {
          "kind": "hello_ack",
          "protocolVersion": "1.0",
          "hostVersion": "0.1.0+net48",
          "hostProduct": "AutoCAD",
          "hostRelease": "R24.1",
          "hostInstanceId": "acad-3f7c1a92",
          "sessionToken": "9f2c1d4a7b0e3856a1c2d3e4f5061728394a5b6c7d8e9f0011223344556677a",
          "serverTimeUtc": "2026-11-21T14:03:11.902Z",
          "clientNonceEcho": "9c1f8b2a4e7d0f61",
          "writeEnabled": false,
          "capabilities": {
            "domains": ["sys", "read", "task"],
            "writeEnabled": false,
            "civilApi": {
              "available": false,
              "product": "AutoCAD",
              "release": "R24.1",
              "probe": "ResolveType('Autodesk.Civil.ApplicationServices.CivilApplication, AeccDbMgd') && CivilApplication.ActiveDocument != null",
              "reason": "Civil 3D 托管 API 不可用（AeccDbMgd 无法解析）：相关对象以 ACAD_PROXY_ENTITY 出现，按缺口上报",
              "writeSupported": false
            },
            "preview": { "formats": ["png"], "maxWidth": 2400, "maxHeight": 1600, "renderMode": "schematic" },
            "messageLimitBytes": 1048576,
            "heartbeat": { "intervalMs": 5000, "missLimit": 3 },
            "cancellation": true,
            "toolCatalogHash": "sha256:1f4b0c8d9e2a7b3c"
          },
          "gaps": [
            {
              "capability": "civil.roadway|corridor|surface|pipe_network",
              "status": "absent",
              "reason": "Civil 3D 托管 API 不可用（AeccDbMgd 无法解析）：相关对象以 ACAD_PROXY_ENTITY 出现",
              "nextAction": "换用 Civil 3D 宿主（含 C3D\\AeccDbMgd.dll），或改用 AutoCAD 原生图元并在成果中明示降级"
            },
            {
              "capability": "write.*",
              "status": "absent",
              "reason": "M0 写入通道硬关闭（writeEnabled=false）",
              "nextAction": "等待 M1 审批写入流程"
            }
          ],
          "missingFeatures": []
        }
      ]
    },
    "Bye": {
      "$id": "#/$defs/Bye",
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "reason"],
      "properties": {
        "kind": { "const": "bye" },
        "reason": {
          "type": "string",
          "enum": [
            "client_shutdown", "host_shutdown", "protocol_violation", "frame_too_large",
            "session_replaced", "heartbeat_timeout", "internal_error"
          ]
        },
        "detail": { "type": ["string", "null"], "maxLength": 500 }
      }
    }
  },
  "oneOf": [
    { "$ref": "#/$defs/Hello" },
    { "$ref": "#/$defs/HelloAck" },
    { "$ref": "#/$defs/Bye" }
  ]
}
