{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://engineering-platform.local/protocol/envelope.schema.json",
  "title": "Engineering Platform Pipe Envelope (protocol 1.0)",
  "description": "命名管道帧载荷的唯一契约。一帧 = 一个 JSON object。分帧规则：4 字节小端 uint32 长度前缀 + UTF-8 JSON 载荷，长度上限 1048576 字节。字段命名全局 camelCase。",
  "oneOf": [
    { "$ref": "#/$defs/RequestEnvelope" },
    { "$ref": "#/$defs/ResponseEnvelope" },
    { "$ref": "#/$defs/HandshakeRequest" },
    { "$ref": "#/$defs/HandshakeResponse" }
  ],
  "$defs": {
    "ProtocolVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+$",
      "description": "主版本.次版本。主版本必须完全相等；客户端次版本可小于等于宿主次版本。"
    },
    "SessionToken": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "description": "宿主签发的会话令牌，32 字节随机数的 hex。随连接生命周期生效，不得落日志。"
    },
    "HostInstanceId": {
      "type": "string",
      "pattern": "^(acad|civil|revit|p3d|mock)-[0-9a-f]{8}$",
      "description": "宿主实例标识：<app>-<8hex>，进程生命周期内不变。"
    },
    "OpId": {
      "type": "string",
      "pattern": "^op-[0-9T:A-Za-z-]{8,64}$",
      "description": "操作编号，全链路唯一，由 MCP 侧生成，宿主原样回填。"
    },
    "Digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$",
      "description": "paramsDigest：canonical params 的 SHA-256。canonical = 递归键排序 + 紧凑分隔符(',',':') + ensure_ascii=false + UTF-8。"
    },
    "Fingerprint": {
      "type": "string",
      "pattern": "^fp1:[0-9a-f]{32}$",
      "description": "图纸指纹。fp1 算法：sha256(路径哈希|Handseed|模型空间对象数|关键句柄排序串|最近保存时间ISO) 取前 32 hex。"
    },
    "UtcDateTime": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$",
      "description": "UTC 时间，固定毫秒精度，Z 结尾。禁止使用本地时间与无毫秒格式。"
    },
    "ToolName": {
      "type": "string",
      "pattern": "^(sys|read|task)_[a-z0-9_]{2,40}$",
      "description": "M0 只允许只读域前缀 sys_ / read_ / task_。写域 cad_/civil_/dyn_/file_/rev_/p3d_/calc_/skill_ 在 M0 一律返回 E2003。"
    },
    "Warning": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message"],
      "properties": {
        "code": { "type": "string", "pattern": "^W[0-9]{4}$" },
        "message": { "type": "string", "maxLength": 500 },
        "detail": { "type": ["string", "null"], "maxLength": 2000 }
      }
    },
    "Error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message", "retriable"],
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^[EC][0-9]{4}$",
          "description": "E#### 为宿主错误码（见 errors.json），C#### 为 MCP 层链路错误码。"
        },
        "message": { "type": "string", "maxLength": 500 },
        "field": { "type": ["string", "null"], "maxLength": 200, "description": "出错的入参路径，如 params.limit。" },
        "detail": { "type": ["string", "null"], "maxLength": 2000 },
        "retriable": { "type": "boolean", "description": "是否允许由 Agent 在修正参数后以新 opId 重试。注意：retriable=true 不代表自动重放。" },
        "userAdvice": { "type": ["string", "null"], "maxLength": 500, "description": "给人看的中文修复建议。" }
      }
    },
    "RequestEnvelope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocolVersion", "sessionToken", "hostInstanceId", "opId", "tool", "params", "timeoutMs", "cancelable"],
      "properties": {
        "protocolVersion": { "$ref": "#/$defs/ProtocolVersion" },
        "sessionToken": { "$ref": "#/$defs/SessionToken" },
        "hostInstanceId": { "$ref": "#/$defs/HostInstanceId" },
        "opId": { "$ref": "#/$defs/OpId" },
        "idempotencyKey": { "type": ["string", "null"], "maxLength": 200, "description": "只读工具可为 null。M0 不用于去重，仅审计。" },
        "tool": { "$ref": "#/$defs/ToolName" },
        "params": { "type": "object", "description": "必须通过该工具 inputSchema；宿主侧强制二次校验。" },
        "paramsDigest": { "anyOf": [{ "$ref": "#/$defs/Digest" }, { "type": "null" }] },
        "targetFingerprint": { "anyOf": [{ "$ref": "#/$defs/Fingerprint" }, { "type": "null" }], "description": "只读工具可 null（宿主现算），响应回填实际值。" },
        "approvalToken": { "type": ["string", "null"], "description": "M0 恒为 null。非 null 一律 E1006。" },
        "timeoutMs": { "type": "integer", "minimum": 500, "maximum": 60000, "default": 15000 },
        "cancelable": { "type": "boolean", "default": true }
      }
    },
    "ResponseEnvelope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocolVersion", "sessionToken", "hostInstanceId", "opId", "tool", "status", "ok", "startedAt", "elapsedMs", "warnings", "result", "error"],
      "properties": {
        "protocolVersion": { "$ref": "#/$defs/ProtocolVersion" },
        "sessionToken": { "$ref": "#/$defs/SessionToken" },
        "hostInstanceId": { "$ref": "#/$defs/HostInstanceId" },
        "opId": { "$ref": "#/$defs/OpId" },
        "tool": { "type": "string", "maxLength": 60, "description": "回填请求工具名；解析失败时为 \"\" 或 \"unknown\"。" },
        "status": {
          "type": "string",
          "enum": ["validated", "queued", "running", "committed", "saved", "verified", "failed", "cancelled", "unknown"],
          "description": "方案 13.3 状态机线上枚举。M0 只读成功终态为 verified；committed/saved 在 M0 不出现。"
        },
        "ok": { "type": "boolean" },
        "startedAt": { "$ref": "#/$defs/UtcDateTime" },
        "elapsedMs": { "type": "integer", "minimum": 0 },
        "paramsDigest": { "anyOf": [{ "$ref": "#/$defs/Digest" }, { "type": "null" }] },
        "targetFingerprint": { "anyOf": [{ "$ref": "#/$defs/Fingerprint" }, { "type": "null" }] },
        "result": {
          "type": ["object", "null"],
          "description": "ok=true 时为工具自定义结果对象，必须含 summary 与 resultRef（见 tools.schema.json）。ok=false 时为 null。"
        },
        "warnings": { "type": "array", "items": { "$ref": "#/$defs/Warning" }, "maxItems": 32 },
        "error": { "anyOf": [{ "$ref": "#/$defs/Error" }, { "type": "null" }] }
      },
      "allOf": [
        {
          "if": { "properties": { "ok": { "const": true } }, "required": ["ok"] },
          "then": { "properties": { "error": { "type": "null" }, "status": { "enum": ["verified", "validated", "queued", "running"] } } }
        },
        {
          "if": { "properties": { "ok": { "const": false } }, "required": ["ok"] },
          "then": { "properties": { "result": { "type": "null" }, "status": { "enum": ["failed", "cancelled", "unknown"] } } }
        }
      ]
    },
    "HandshakeRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "protocolVersion", "clientInfo", "clientNonce"],
      "properties": {
        "kind": { "const": "hello" },
        "protocolVersion": { "$ref": "#/$defs/ProtocolVersion" },
        "clientInfo": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "version"],
          "properties": {
            "name": { "type": "string", "maxLength": 80 },
            "version": { "type": "string", "maxLength": 40 },
            "pid": { "type": ["integer", "null"] }
          }
        },
        "clientNonce": { "type": "string", "pattern": "^[0-9a-f]{16,64}$" },
        "requestedFeatures": { "type": "array", "items": { "type": "string", "maxLength": 60 }, "maxItems": 20 }
      }
    },
    "HandshakeResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "protocolVersion", "hostVersion", "hostProduct", "hostRelease", "hostInstanceId", "sessionToken", "serverTimeUtc", "writeEnabled", "capabilities", "gaps"],
      "properties": {
        "kind": { "const": "hello_ack" },
        "protocolVersion": { "$ref": "#/$defs/ProtocolVersion" },
        "hostVersion": { "type": "string", "maxLength": 40, "description": "插件版本号（如 0.1.0+net48）。实例发现文件与 MCP instances.py 同名字段语义必须一致，不要复用为 CAD 版本。" },
        "hostProduct": { "type": "string", "enum": ["AutoCAD", "Civil3D"], "description": "宿主产品（反射探测 AeccDbMgd 得到，不是猜的）。" },
        "hostRelease": { "type": "string", "pattern": "^R[0-9]+\\.[0-9]+$", "examples": ["R24.3", "R23.0", "R24.1"], "description": "宿主发行版本（ACADVER，如 24.3s → R24.3）。" },
        "hostInstanceId": { "$ref": "#/$defs/HostInstanceId" },
        "sessionToken": { "$ref": "#/$defs/SessionToken" },
        "serverTimeUtc": { "$ref": "#/$defs/UtcDateTime" },
        "clientNonceEcho": { "type": ["string", "null"] },
        "writeEnabled": { "const": false, "description": "M0 硬关闭。任何版本都不允许为 true。" },
        "capabilities": {
          "type": "object",
          "additionalProperties": false,
          "required": ["domains", "writeEnabled", "civilApi", "preview", "messageLimitBytes", "heartbeat", "cancellation", "toolCatalogHash"],
          "properties": {
            "domains": { "type": "array", "items": { "enum": ["sys", "read", "task"] }, "minItems": 1 },
            "writeEnabled": { "const": false },
            "civilApi": {
              "type": "object",
              "additionalProperties": false,
              "required": ["available", "probe"],
              "properties": {
                "available": { "type": "boolean" },
                "product": { "type": "string", "enum": ["AutoCAD", "Civil3D"] },
                "release": { "type": "string", "maxLength": 40 },
                "probe": { "type": "string", "maxLength": 500 },
                "reason": { "type": ["string", "null"], "maxLength": 500 },
                "writeSupported": { "type": "boolean", "description": "M0 恒 false：Civil 3D 的创建/修改 API 一个都没实现。" }
              }
            },
            "preview": {
              "type": "object",
              "additionalProperties": false,
              "required": ["formats", "maxWidth", "maxHeight", "renderMode"],
              "properties": {
                "formats": { "type": "array", "items": { "enum": ["png"] }, "minItems": 1 },
                "maxWidth": { "type": "integer", "minimum": 200, "maximum": 4096 },
                "maxHeight": { "type": "integer", "minimum": 200, "maximum": 4096 },
                "renderMode": { "type": "string", "enum": ["schematic", "plot"], "description": "M0 固定 schematic：由语义模型几何绘制的结构示意图，非出图成果。" }
              }
            },
            "messageLimitBytes": { "const": 1048576 },
            "heartbeat": {
              "type": "object",
              "additionalProperties": false,
              "required": ["intervalMs", "missLimit"],
              "properties": {
                "intervalMs": { "const": 5000 },
                "missLimit": { "const": 3 }
              }
            },
            "cancellation": { "type": "boolean" },
            "toolCatalogHash": { "type": "string", "pattern": "^sha256:[0-9a-f]{16,64}$" }
          }
        },
        "gaps": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["capability", "status", "reason"],
            "properties": {
              "capability": { "type": "string", "maxLength": 120 },
              "status": { "type": "string", "enum": ["absent", "degraded", "unverified"] },
              "reason": { "type": "string", "maxLength": 500 },
              "nextAction": { "type": ["string", "null"], "maxLength": 500 }
            }
          }
        },
        "missingFeatures": { "type": "array", "items": { "type": "string", "maxLength": 60 }, "maxItems": 20 },
        "warnings": {
          "type": "array",
          "description": "握手阶段告警（与 handshake.schema.json#/$defs/HelloAck.warnings 同义）。次版本超前时带 W1002。",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["code", "message"],
            "properties": {
              "code": { "type": "string", "pattern": "^W[0-9]{4}$" },
              "message": { "type": "string", "maxLength": 500 },
              "detail": { "type": ["string", "null"], "maxLength": 2000 }
            }
          },
          "maxItems": 10
        }
      }
    },
    "ByeFrame": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "reason"],
      "properties": {
        "kind": { "const": "bye" },
        "reason": { "type": "string", "maxLength": 200 }
      }
    }
  }
}
