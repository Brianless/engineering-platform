<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Engineering Platform Host（M0 只读）。
    - 目标框架 net48
    - 用 Microsoft.NETFramework.ReferenceAssemblies 提供 net48 参考程序集（本机无完整 VS）
    - AutoCAD / Civil 3D 托管程序集一律 HintPath + Private=false（绝不复制 Autodesk DLL）
    - 宿主根目录可切换：-p:AcadRoot="..."（默认 Civil 3D 2024）
    - Civil 3D API 在 <AcadRoot>\C3D\ 子目录；不存在时不引用，代码走反射探测
    - 条件开关 HOST_BUILD_NO_CAD=1：跳过所有 Autodesk 引用，仅编译「无 CAD」骨架子集
  -->

  <PropertyGroup>
    <!--
      双目标（2026-11-22）：
        net48           → AutoCAD 2022 / Civil 3D 2019 / Civil 3D 2024（.NET Framework 4.8）
        net8.0-windows  → AutoCAD 2025+（AutoCAD 2025 起运行时是 .NET 8）
      两个产物的 API 面几乎一致，差异集中在三处：管道 ACL 重载、JavaScriptSerializer、GAC 引用。
      见 docs/10-M1-写通道设计.md §十二 与 docs/evidence/20261122-acad2025-net8-crash.md。
    -->
    <TargetFrameworks>net48;net8.0-windows</TargetFrameworks>
    <AssemblyName>EngineeringHost</AssemblyName>
    <RootNamespace>EngineeringPlatform.Host</RootNamespace>
    <OutputType>Library</OutputType>
    <EnableDefaultCompileItems>true</EnableDefaultCompileItems>
    <AutoGenerateBindingRedirects>false</AutoGenerateBindingRedirects>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <AppendTargetFrameworkToOutputPath>true</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <!-- net8 档：AutoCAD 2025 的托管程序集在 2025 安装目录；WinForms 由 SDK 提供（不再走 GAC 引用） -->
  <PropertyGroup Condition="'$(TargetFramework)' == 'net8.0-windows'">
    <UseWindowsForms>true</UseWindowsForms>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <AcadRoot Condition="'$(EP_ACAD2025_ROOT)' != ''">$(EP_ACAD2025_ROOT)</AcadRoot>
    <AcadRoot Condition="'$(EP_ACAD2025_ROOT)' == '' and '$(AcadRoot)' == 'C:\Program Files\Autodesk\AutoCAD 2024' and Exists('C:\Program Files\Autodesk\AutoCAD 2025\acmgd.dll')">C:\Program Files\Autodesk\AutoCAD 2025</AcadRoot>
    <AcadRoot Condition="'$(EP_ACAD2025_ROOT)' == '' and '$(AcadRoot)' == 'D:\AutoCAD\AotoCAD Civil\AutoCAD 2024' and Exists('D:\AutoCAD\AotoCAD Civil\2025\AutoCAD 2025\acmgd.dll')">D:\AutoCAD\AotoCAD Civil\2025\AutoCAD 2025</AcadRoot>
    <!--
      Civil 目录与探测结果必须跟着 AcadRoot 一起改：Directory.Build.props 在 TFM 未知时
      就已经用默认（2024）路径算过一遍，不改这两行，net8 产物会引用**2024 的 net48
      AeccDbMgd**（虽然代码全走反射、不会在运行时崩，但这是latent trap）。
    -->
    <AcadCivilDir>$(AcadRoot)\C3D</AcadCivilDir>
    <HasCivilAssemblies Condition="Exists('$(AcadCivilDir)\AeccDbMgd.dll')">true</HasCivilAssemblies>
    <HasCivilAssemblies Condition="!Exists('$(AcadCivilDir)\AeccDbMgd.dll')">false</HasCivilAssemblies>
  </PropertyGroup>

  <PropertyGroup Condition="'$(HOST_BUILD_NO_CAD)' == '1'">
    <DefineConstants>$(DefineConstants);HOST_NO_CAD</DefineConstants>
  </PropertyGroup>

  <!-- GAC 引用只对 net48 有意义；net8 由框架包提供同名类型 -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <Reference Include="System" />
    <Reference Include="System.Core" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Web.Extensions" />
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
  </ItemGroup>

  <!-- net8：命名管道 ACL + Roslyn C# 内存编译引擎（v3.0 Phase 3） -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0-windows'">
    <PackageReference Include="System.IO.Pipes.AccessControl" Version="5.0.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.8.0" />
  </ItemGroup>

  <!-- AutoCAD 核心托管程序集（三套宿主根目录均有 acmgd/acdbmgd/accoremgd） -->
  <ItemGroup Condition="'$(HOST_BUILD_NO_CAD)' != '1'">
    <Reference Include="acmgd">
      <HintPath>$(AcadRoot)\acmgd.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="acdbmgd">
      <HintPath>$(AcadRoot)\acdbmgd.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="accoremgd">
      <HintPath>$(AcadRoot)\accoremgd.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- AecBaseMgd：Civil 3D 与 Architecture 共用的 AEC 基类。
         AutoCAD 2022 根目录没有该文件，故用 Exists 条件保护。 -->
    <Reference Include="AecBaseMgd" Condition="Exists('$(AcadRoot)\AecBaseMgd.dll')">
      <HintPath>$(AcadRoot)\AecBaseMgd.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- Civil 3D 托管 API（<AcadRoot>\C3D\AeccDbMgd.dll）。
       只有 2024 / 2019 有该子目录；AutoCAD 2022 不引用，编译常量 CIVIL3D 亦不定义，
       代码用反射探测（CivilApiProbe），探测不到才走 gaps[] / W1001 降级路径。 -->
  <ItemGroup Condition="'$(HasCivilAssemblies)' == 'true' and '$(HOST_BUILD_NO_CAD)' != '1'">
    <Reference Include="AeccDbMgd">
      <HintPath>$(AcadCivilDir)\AeccDbMgd.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\layer-map.default.json" />
    <EmbeddedResource Include="Resources\block-map.default.json" />
    <EmbeddedResource Include="..\protocol\tools.schema.json" LogicalName="protocol/tools.schema.json" />
  </ItemGroup>

</Project>
