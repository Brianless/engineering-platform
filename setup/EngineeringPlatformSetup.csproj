<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>EngineeringPlatform-Setup</AssemblyName>
    <RootNamespace>EngineeringPlatform.Setup</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Version>1.0.0</Version>
    <Product>Engineering Platform v1.0.0 — 全版本 CAD 一体化安装配置中心</Product>
    <Company>Engineering Platform</Company>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>

  <ItemGroup Condition="Exists('payload\payload.zip')">
    <EmbeddedResource Include="payload\payload.zip" LogicalName="payload.zip" />
  </ItemGroup>

</Project>
